.hero-plate {
  position: relative;
  isolation: isolate;
  background-color: var(--ui-bg);
}
.hero-plate::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -2;
  background-image: radial-gradient(var(--halftone-dot) 1.15px, transparent 1.25px);
  background-size: 9px 9px;
  -webkit-mask-image: radial-gradient(76% 70% at var(--hx, 74%) var(--hy, 32%), #000 0%, transparent 72%);
  mask-image: radial-gradient(76% 70% at var(--hx, 74%) var(--hy, 32%), #000 0%, transparent 72%);
  animation: halftone-drift 24s linear infinite;
}
.hero-plate::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background-image: radial-gradient(110% 90% at 78% 16%, rgba(47, 107, 201, 0.34), transparent 64%);
}
.plate {
  position: relative;
  overflow: hidden;
  background-color: var(--plate-bg);
  background-image: radial-gradient(var(--plate-dot) 1.1px, transparent 1.2px);
  background-size: 8px 8px;
}
.accent {
  --accent: var(--ui-primary);
  background-color: var(--accent);
  @supports (color: color-mix(in lab, red, red)) {
    background-color: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  color: var(--accent);
  @supports (color: color-mix(in lab, red, red)) {
    color: color-mix(in oklab, var(--accent) 62%, var(--ui-text));
  }
}
.accent-plain {
  color: var(--accent, var(--ui-primary));
  @supports (color: color-mix(in lab, red, red)) {
    color: color-mix(in oklab, var(--accent, var(--ui-primary)) 62%, var(--ui-text));
  }
}
.accent-text {
  color: var(--accent, var(--ui-primary));
  @supports (color: color-mix(in lab, red, red)) {
    color: color-mix(in oklab, var(--accent, var(--ui-primary)) 62%, var(--ui-text));
  }
}
.card-hover {
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
