  from {
    background-position: 0 0;
  }
  to {
    background-position: 4.5px 4.5px;
  }
}
@keyframes hero-enter {
  from {
    opacity: 0;
    filter: blur(6px);
    transform: translateY(16px);
  }
  to {
    opacity: 1;
    filter: blur(0);
    transform: none;
  }
}
.hero-enter {
  animation: hero-enter 900ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
}
.hero-stagger > * {
  animation: hero-enter 900ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
}
.hero-stagger > :nth-child(2) {
  animation-delay: 110ms;
}
.hero-stagger > :nth-child(3) {
  animation-delay: 220ms;
}
.link-draw {
  background-image: linear-gradient(currentColor, currentColor);
  background-repeat: no-repeat;
  background-size: 0% 1px;
  background-position: 0 calc(100% - 4px);
  transition: background-size 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.link-draw:hover, .link-draw:focus-visible {
  background-size: 100% 1px;
}
@media (prefers-reduced-motion: reduce) {
  .hero-plate::before, .hero-enter, .hero-stagger > * {
    animation: none;
  }
  .link-draw {
    transition: none;
  }
